{
  "name": "@lofty/design-system",
  "version": "1.0.0",
  "description": "Lofty's app design system — brand palette, tokens, and 61 components. Inherits monday.com Vibe.",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoftySupport/loftybrand.git"
  },
  "main": "styles.css",
